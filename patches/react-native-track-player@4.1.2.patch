@@ -158,6 +158,32 @@ class MusicService : HeadlessJsTaskService() {
 
         player = QueuedAudioPlayer(this@MusicService, playerConfig, bufferConfig, cacheConfig)
         player.automaticallyUpdateNotificationMetadata = automaticallyUpdateNotificationMetadata
+
+        // MeloVault: expose the ExoPlayer audio session id to the in-app native
+        // equalizer (com.melovault.AudioEffects) so it can attach an Equalizer.
+        // Done via reflection because RNTP cannot depend on the app module.
+        try {
+            val getExo = Class.forName("com.doublesymmetry.kotlinaudio.players.BaseAudioPlayer")
+                .getDeclaredMethod("getExoPlayer")
+            getExo.isAccessible = true
+            val exo = getExo.invoke(player) as com.google.android.exoplayer2.ExoPlayer
+            fun pushSession(id: Int) {
+                try {
+                    val ae = Class.forName("com.melovault.AudioEffects")
+                    ae.getMethod("attachSession", Int::class.javaPrimitiveType)
+                        .invoke(ae.getField("INSTANCE").get(null), id)
+                } catch (_: Exception) {}
+            }
+            pushSession(exo.audioSessionId)
+            exo.addListener(object : com.google.android.exoplayer2.Player.Listener {
+                override fun onAudioSessionIdChanged(audioSessionId: Int) {
+                    pushSession(audioSessionId)
+                }
+            })
+        } catch (e: Exception) {
+            android.util.Log.w("MeloVault", "EQ session hook failed: ${e.message}")
+        }
